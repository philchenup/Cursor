<?xml version="1.0" encoding="UTF-8"?>
<rlplan xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="rlplan.xsd">
	<addRrtConCon>
		<duration>100</duration>
		<model>
			<kinematics href="./wrl/KR16_1610_2_gantry.xml" type="mdl"/>
			<model>0</model>
			<scene href="./wrl/KR16_1610_2_boxes_gantry.xml"/>
		</model>
		<delta unit="deg">10</delta>
		<epsilon>0.1</epsilon>
		<uniformSampler/>
		<alpha>10</alpha>
		<lower unit="deg">2</lower>
		<radius unit="deg">500</radius>
	</addRrtConCon>
	<!--
		优化器参数说明(场景为 mm, 关节空间 = 地轨[mm] + 6转轴[rad] 的混合单位):

		recursiveVerifier/delta  捷径碰撞检测步长(混合单位)。
		    原值 1° = 0.0175: 地轨方向每 0.017mm 检一次碰撞, 每条候选捷径要做上万次碰撞查询, 这是慢的主因之一。
		    调为 0.15, 与规划器 delta(10° = 0.175)同量级 —— 优化器没必要比生成该路径的规划器检得更细。
		    可调范围 0.1 ~ 0.2: 越小越安全越慢。

		length  路径细分段长(混合单位)。AdvancedOptimizer 会先把所有段细分到 <= length 再反复做三点去捷径,
		    每一遍对每个三元组都要调一次 verifier。
		    原值 500° = 8.73: 一条几米长(几千 mm)的路径会被切成几百个路点, 三元组数量和碰撞查询量爆炸。
		    调为 150(约 150mm 一段), 路点数下降约 20 倍。粗化不影响回放, PlanWorker 输出前会按 interpStep 重新稠密插值。
		    可调范围 100 ~ 300。

		ratio  去点阈值: 中间点偏离直连线超过 ratio*|ik| 才删除。0.3 比库默认 0.1 收敛更快, 保持不变。
	-->
	<advancedOptimizer>
		<recursiveVerifier>
			<delta>0.15</delta>
		</recursiveVerifier>
		<length>150</length>
		<ratio>0.3</ratio>
	</advancedOptimizer>
	<!--
		若对路径长度要求不高、追求最快优化速度, 可用下面的轻量优化器替换整个 <advancedOptimizer> 块
		(loadRobotWidget 已支持该节点; SimpleOptimizer 只做贪心去点, 不细分, 通常几十次碰撞查询即可完成):

	<simpleOptimizer>
		<recursiveVerifier>
			<delta>0.15</delta>
		</recursiveVerifier>
	</simpleOptimizer>
	-->
</rlplan>
