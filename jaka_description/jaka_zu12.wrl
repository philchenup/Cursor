#VRML V2.0 utf8
# JAKA Zu12 assembly.
# Each link_i translation/rotation is the URDF origin of the joint from
# Link_{i-1} to Link_i (parent-relative, meters, radians).
# URDF rpy (roll pitch yaw) is converted to VRML axis-angle (x y z angle).
# link0 also includes the world->Link_0 fixed joint (xyz 0 0 0.04).
Transform {
	children [
		DEF link0 Transform {
			translation 0 0 0.04
			rotation 0 0 0 0
			children [
				Inline {
					url "link0.wrl"
				}
			]
		}
		DEF link1 Transform {
			translation 0 0 0.10265
			rotation 0 0 0 0
			children [
				Inline {
					url "link1.wrl"
				}
			]
		}
		DEF link2 Transform {
			translation 0 0 0
			rotation 1 0 0 1.5708
			children [
				Inline {
					url "link2.wrl"
				}
			]
		}
		DEF link3 Transform {
			translation 0.595 0 0
			rotation 0 0 0 0
			children [
				Inline {
					url "link3.wrl"
				}
			]
		}
		DEF link4 Transform {
			translation 0.5715 0 -0.1315
			rotation 0 0 0 0
			children [
				Inline {
					url "link4.wrl"
				}
			]
		}
		DEF link5 Transform {
			translation 0 -0.115 0
			rotation 1 0 0 1.5708
			children [
				Inline {
					url "link5.wrl"
				}
			]
		}
		DEF link6 Transform {
			translation 0 0.1035 0
			rotation 1 0 0 -1.5708
			children [
				Inline {
					url "link6.wrl"
				}
			]
		}
	]
}
