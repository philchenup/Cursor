<?xml version="1.0" encoding="UTF-8"?>
<!--
  机器人作 Server（EXTERNAL/TYPE=Client）时的正确写法：
  1) EXTERNAL 的 IP/PORT 会被忽略，不要只写在 EXTERNAL
  2) 必须在 INTERNAL 写机器人监听 IP + PORT
  3) INTERNAL/PORT 只能是 54600..54615（59152 会导致 EKI_Init 失败）
  4) 文件放到：C:\KRC\ROBOTER\Config\User\Common\EthernetKRL\Xml_motion16.xml
  5) 上位机 connectToHost(机器人IP, 54600)
-->
<ETHERNETKRL>
	<CONFIGURATION>
		<EXTERNAL>
			<!-- 外部系统=客户端；此处 IP/PORT 在 TYPE=Client 时无效 -->
			<TYPE>Client</TYPE>
		</EXTERNAL>
		<INTERNAL>
			<ENVIRONMENT>Program</ENVIRONMENT>
			<BUFFERING Mode="FIFO" Limit="512"/>
			<BUFFSIZE Limit="16384"/>
			<TIMEOUT Connect="60000"/>
			<ALIVE Set_Flag="1" Ping="200"/>
			<!-- 机器人网卡 IP（KLI 等），按实际修改 -->
			<IP>172.31.1.147</IP>
			<!-- 必须在 54600..54615 -->
			<PORT>54600</PORT>
			<PROTOCOL>TCP</PROTOCOL>
		</INTERNAL>
	</CONFIGURATION>
	<RECEIVE>
		<XML>
			<ELEMENT Tag="Sensor/SJ1" Type="REAL"/>
			<ELEMENT Tag="Sensor/SJ2" Type="REAL"/>
			<ELEMENT Tag="Sensor/SJ3" Type="REAL"/>
			<ELEMENT Tag="Sensor/SJ4" Type="REAL"/>
			<ELEMENT Tag="Sensor/SJ5" Type="REAL"/>
			<ELEMENT Tag="Sensor/SJ6" Type="REAL"/>
			<ELEMENT Tag="Sensor/SE1" Type="REAL"/>
			<ELEMENT Tag="Sensor/Status/IsOut" Type="BOOL"/>
			<ELEMENT Tag="Sensor/StepMode" Type="INT"/>
			<ELEMENT Tag="Sensor" Set_Flag="1"/>
		</XML>
	</RECEIVE>
	<SEND>
		<XML>
			<ELEMENT Tag="Robot/PE1"/>
			<ELEMENT Tag="Robot/joint1"/>
			<ELEMENT Tag="Robot/joint2"/>
			<ELEMENT Tag="Robot/joint3"/>
			<ELEMENT Tag="Robot/joint4"/>
			<ELEMENT Tag="Robot/joint5"/>
			<ELEMENT Tag="Robot/joint6"/>
			<ELEMENT Tag="Robot/PX"/>
			<ELEMENT Tag="Robot/PY"/>
			<ELEMENT Tag="Robot/PZ"/>
			<ELEMENT Tag="Robot/PA"/>
			<ELEMENT Tag="Robot/PB"/>
			<ELEMENT Tag="Robot/PC"/>
		</XML>
	</SEND>
</ETHERNETKRL>
