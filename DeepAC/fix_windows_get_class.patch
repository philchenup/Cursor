+def file_path_to_mod_path(file_path, base_path):
+    """Convert a .py filesystem path to a dotted module path starting at base_path.
+
+    Original DeepAC only replaced POSIX '/' with '.', so on Windows a path like
+    ``E:\\...\\src_open\\models\\deep_ac.py`` never contained ``src_open.models``.
+    ``str.find`` then returned -1 and ``whole_path[-1:]`` became the last
+    character of the filename (``'c'`` in ``deep_ac``), causing
+    ``ModuleNotFoundError: No module named 'c'``.
+    """
+    root, ext = os.path.splitext(file_path)
+    if ext.lower() != '.py':
+        root = file_path[:-3]
+    whole_path = root.replace('\\', '.').replace('/', '.')
+    p = whole_path.find(base_path)
+    if p < 0:
+        raise ModuleNotFoundError(
+            "Cannot map file {!r} onto package {!r} (converted path: {!r})".format(
+                file_path, base_path, whole_path)
+        )
+    return whole_path[p:]
+
